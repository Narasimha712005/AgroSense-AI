# AgroSense AI - Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to git.

# JWT signing key - generate a strong random value for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-strong-random-secret

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
# Development (SQLite): sqlite+aiosqlite:///./agrosense.db
# Production (PostgreSQL): postgresql+asyncpg://user:password@host:5432/dbname
# Render "postgres://..." URLs are auto-converted to asyncpg format.
DATABASE_URL=sqlite+aiosqlite:///./agrosense.db

# Weather API key (OpenWeatherMap) - optional, demo mode works without it
WEATHER_API_KEY=demo

# URLs
# Frontend (Vercel) - used for CORS and links inside emails
FRONTEND_URL=http://localhost:5173
# Backend public URL (Render) - used for the Google OAuth redirect URI
BACKEND_URL=http://localhost:8000

# Extra allowed CORS origins, comma-separated (e.g. Vercel preview URLs)
CORS_ORIGINS=

# Email verification
# Set to True in production to block login until the email is verified
REQUIRE_EMAIL_VERIFICATION=False

# Email delivery mode: console | smtp | sendgrid
#   console  - logs the verification/reset links (development)
#   smtp     - Gmail: use an App Password (Google Account > Security > App Passwords)
#   sendgrid - set SENDGRID_API_KEY
EMAIL_MODE=console
EMAIL_FROM=AgroSense AI <no-reply@agrosense.ai>

# SMTP settings (EMAIL_MODE=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# SendGrid (EMAIL_MODE=sendgrid)
SENDGRID_API_KEY=

# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI must be: {BACKEND_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
